{
  "name": "blitzpay-kitchen",
  "version": "0.1.0",
  "description": "BlitzPay Kitchen Screen (Electron kiosk)",
  "author": "Elegant Software",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && electron .",
    "mock": "node mock/server.mjs",
    "test": "tsc && node --test",
    "package": "tsc && electron-builder",
    "test:theme": "node scripts/keycloak-theme-smoke.mjs",
    "test:ui": "tsc && electron scripts/ui-smoke.cjs"
  },
  "dependencies": {
    "keycloak-js": "^26.2.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "software.elegant.blitzpay.kitchen",
    "productName": "BlitzPay Kitchen",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "renderer/**",
      "config.json",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
